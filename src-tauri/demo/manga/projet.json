          "children": [
            { "key": "pr", "title": "Prologue — L'avalanche", "numbered": false, "summary": "Il y a sept ans, Ren sauve sa sœur Hina dans le tunnel n° 7. Elle survit et perd la voix.", "manga": { "narrativeGoal": "Poser le deuil, le tunnel et l'indice des deux panaches, en trois pages presque muettes.", "pageGoal": 3, "scriptStatus": "final" } },
            { "key": "ch1", "title": "La voix qui reste", "summary": "Hina comprend qu'elle entend les dernières paroles des morts. Il reste trente jours avant la mise en eau. La Compagnie la remarque.", "manga": { "narrativeGoal": "Installer le monde, le don, le compte à rebours et le trio Hina, Tokubei, Nobu. Finir sur la directrice.", "pageGoal": 9, "scriptStatus": "final" } },
            { "key": "ch2", "title": "Trente jours", "summary": "La tournée des lanternes. Sōta change de camp. Tokubei tremble. La clé du tunnel est retrouvée.", "manga": { "narrativeGoal": "Faire aimer le quotidien et le train avant de tout casser. Semer les indices sur Tokubei.", "pageGoal": 8, "scriptStatus": "final" },
              "children": [{ "key": "scene-coupee", "title": "Cérémonie au sanctuaire (coupée)", "summary": "Scène retirée au storyboard : ralentissait le milieu du chapitre." }] },
            { "key": "ch3", "title": "Le tunnel n° 7", "summary": "Hina entre dans le tunnel, entend Ren et apprend que Tokubei tenait le détonateur. Yae lui révèle le Puits des voix.", "manga": { "narrativeGoal": "La grande révélation du tome. Laisser la plus belle image précéder la plus dure.", "pageGoal": 9, "scriptStatus": "review" } }
          ]
        }]
      },
      {
        "key": "arc2", "title": "Les eaux", "summary": "La vérité sur le barrage, le face-à-face avec Madoka et le dernier train vers le Puits.",
        "children": [{
