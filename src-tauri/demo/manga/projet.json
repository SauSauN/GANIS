            { "key": "ch5", "title": "Le barrage", "summary": "Hina rend à Madoka la voix de sa fille. Le conseil avance la mise en eau. Personne ne croit Sōta.", "manga": { "narrativeGoal": "Humaniser l'antagoniste sans l'excuser. Fermer toutes les portes avant le dernier acte.", "pageGoal": 8, "scriptStatus": "progress" } },
