# Récupération du mot de passe par code e-mail (Supabase).
#
# Copier ce fichier en `.env` et remplir les deux valeurs (Supabase ›
# Project Settings › API). Sans elles, la fonction est cachée.
#
# La clé « anon » est publique par conception : la table
# `recovery_escrow` est protégée par ses règles RLS (voir
# supabase/recovery_escrow.sql). Ne mettez JAMAIS la clé `service_role` ici.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=
